                :DataPolicy
                :InputSpec
                :Obligation
                :OutputSpec
                :Prohibition
                :SuperCheckable
                :Tag
                :UsageContext
                :User
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Action
                :App
                :AppPolicy
                :DataPolicy
                :Obligation
                :Prohibition
                :SuperCheckable
                :Tag
                :User
              )
] .


