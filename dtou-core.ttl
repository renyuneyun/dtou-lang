#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Action
                :ActivationCondition
                :App
                :AppPolicy
                :Attribute
                :AttributeClass
                :AttributeName
                :AttributeValue
                :Category
                :Data
                :DataPolicy
                :Downstream
                :InputSpec
                :Obligation
                :ObligationClass
                :OutputSpec
                :Prohibition
                :SuperCheckable
                :Tag
                :UsageContext
                :UseMode
                :User
              )
] .


