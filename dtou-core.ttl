@prefix : <urn:dtou:core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <urn:dtou:core#> .

<urn:dtou:core> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  urn:dtou:core#action
:action rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#activation_condition
:activation_condition rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#app
:app rdf:type owl:ObjectProperty ;
     rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#app_name
:app_name rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#argument
:argument rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#attribute
:attribute rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#attribute_ref
:attribute_ref rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#class
:class rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#data
:data rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#descriptor
:descriptor rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#downstream
:downstream rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#expect
:expect rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#from
:from rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#input_spec
:input_spec rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#integrity
:integrity rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :tagging .


###  urn:dtou:core#name
:name rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#obligation
:obligation rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#obligation_class
:obligation_class rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#output_spec
:output_spec rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#policy
:policy rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#port
:port rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#prohibition
:prohibition rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#provide
:provide rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#purpose
:purpose rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#requirement
:requirement rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :tag .


###  urn:dtou:core#security
:security rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :requirement .


###  urn:dtou:core#tag
:tag rdf:type owl:ObjectProperty ;
     rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#tagging
:tagging rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :tag .


###  urn:dtou:core#uri
:uri rdf:type owl:ObjectProperty ;
     rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#validity_binding
:validity_binding rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty .


###  urn:dtou:core#value
:value rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf owl:topObjectProperty .


#################################################################
#    Classes
#################################################################

###  urn:dtou:core#Action
:Action rdf:type owl:Class .


###  urn:dtou:core#ActivationCondition
:ActivationCondition rdf:type owl:Class .


###  urn:dtou:core#Aggregate
:Aggregate rdf:type owl:Class ;
           rdfs:subClassOf :UseMode .


###  urn:dtou:core#App
:App rdf:type owl:Class .


###  urn:dtou:core#AppPolicy
:AppPolicy rdf:type owl:Class .


###  urn:dtou:core#Attribute
:Attribute rdf:type owl:Class .


###  urn:dtou:core#AttributeClass
:AttributeClass rdf:type owl:Class .


###  urn:dtou:core#AttributeName
:AttributeName rdf:type owl:Class .


###  urn:dtou:core#AttributeValue
:AttributeValue rdf:type owl:Class .


###  urn:dtou:core#Category
:Category rdf:type owl:Class .


###  urn:dtou:core#Data
:Data rdf:type owl:Class .


###  urn:dtou:core#DataPolicy
:DataPolicy rdf:type owl:Class .


###  urn:dtou:core#Downstream
:Downstream rdf:type owl:Class .


###  urn:dtou:core#InputSpec
:InputSpec rdf:type owl:Class .


###  urn:dtou:core#Integrity
:Integrity rdf:type owl:Class ;
           rdfs:subClassOf :Tagging .


###  urn:dtou:core#IntegrityTag
:IntegrityTag rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Tag
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :descriptor ;
                                                           owl:hasValue :IntegrityCategory
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :TaggingTag ;
              owl:disjointWith :PurposeTag .


###  urn:dtou:core#Obligation
:Obligation rdf:type owl:Class .


###  urn:dtou:core#ObligationClass
:ObligationClass rdf:type owl:Class .


###  urn:dtou:core#OutputSpec
:OutputSpec rdf:type owl:Class .


###  urn:dtou:core#Prohibition
:Prohibition rdf:type owl:Class .


###  urn:dtou:core#Purpose
:Purpose rdf:type owl:Class ;
         rdfs:subClassOf :Tagging .


###  urn:dtou:core#PurposeTag
:PurposeTag rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Tag
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :descriptor ;
                                                         owl:hasValue :PurposeCategory
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :TaggingTag .


###  urn:dtou:core#Requirement
:Requirement rdf:type owl:Class ;
             rdfs:subClassOf :TagName ;
             owl:disjointWith :Tagging .


###  urn:dtou:core#RequirementCategory
:RequirementCategory rdf:type owl:Class ;
                     rdfs:subClassOf :Category ;
                     owl:disjointWith :TaggingCategory .


###  urn:dtou:core#RequirementTag
:RequirementTag rdf:type owl:Class ;
                rdfs:subClassOf :Tag ;
                owl:disjointWith :TaggingTag .


###  urn:dtou:core#Security
:Security rdf:type owl:Class ;
          rdfs:subClassOf :Requirement .


###  urn:dtou:core#SecurityTag
:SecurityTag rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Tag
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :descriptor ;
                                                          owl:hasValue :SecurityCategory
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :RequirementTag .


###  urn:dtou:core#Share
:Share rdf:type owl:Class ;
       rdfs:subClassOf :UseMode .


###  urn:dtou:core#SuperCheckable
:SuperCheckable rdf:type owl:Class .


###  urn:dtou:core#Tag
:Tag rdf:type owl:Class .


###  urn:dtou:core#TagName
:TagName rdf:type owl:Class ;
         rdfs:subClassOf :SuperCheckable ;
         rdfs:comment """Here is where vocabulary should define custom concepts for Tags.
The new Tag type should use punning, i.e. it is both a class and an individual. It should be a subclass under the corresponding class, and an individual of type TagName (and/or any of its subclasses).""" .


###  urn:dtou:core#Tagging
:Tagging rdf:type owl:Class ;
         rdfs:subClassOf :TagName .


###  urn:dtou:core#TaggingCategory
:TaggingCategory rdf:type owl:Class ;
                 rdfs:subClassOf :Category .


###  urn:dtou:core#TaggingTag
:TaggingTag rdf:type owl:Class ;
            rdfs:subClassOf :Tag .


###  urn:dtou:core#UsageContext
:UsageContext rdf:type owl:Class .


###  urn:dtou:core#Use
:Use rdf:type owl:Class ;
     rdfs:subClassOf :UseMode .


###  urn:dtou:core#UseMode
:UseMode rdf:type owl:Class .


###  urn:dtou:core#User
:User rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  urn:dtou:core#IntegrityCategory
:IntegrityCategory rdf:type owl:NamedIndividual ,
                            :TaggingCategory .


###  urn:dtou:core#PurposeCategory
:PurposeCategory rdf:type owl:NamedIndividual ,
                          :TaggingCategory .


###  urn:dtou:core#SecurityCategory
:SecurityCategory rdf:type owl:NamedIndividual ,
                           :RequirementCategory .


