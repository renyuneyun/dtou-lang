######
# For debug query
######

# {
#     ?x a dtou:ProhibitedUse; dtou:condition ?ac.
# } => {
#     ?x a dtou:DebugOutput.
#     ?ac a dtou:DebugOutput.
# }.

# { ?x a dtou:OutputObligation } => { ?x a dtou:DebugOutput }.
