@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix dtou: <urn:dtou:core#>.
@prefix dri: <urn:dtou:internal#>.
@prefix : <http://example.org/ns#>.

######
# Helper implications for the language
######

###
# General helper
###
{ ?x dtou:attribute_ref [ dtou:class ?N ].  } => { ?x dtou:descriptor ?N.  }.

## TODO: Delete these lines as they are no longer necessary
# { ?x a dtou:SecurityTag.  } => { ?x dtou:category dtou:SecurityType.  }.
# { ?x a dtou:IntegrityTag.  } => { ?x dtou:category dtou:IntegrityType.  }.
# { ?x a dtou:PurposeTag.  } => { ?x dtou:category dtou:PurposeType.  }.
# { ?x a dtou:PurposeExpectation.  } => { ?x dtou:category dtou:PurposeType.  }.
# { ?x a dtou:IntegrityExpectation.  } => { ?x dtou:category dtou:IntegrityType.  }.
# { ?x a dtou:SecurityProvide.  } => { ?x dtou:category dtou:SecurityType.  }.

{ ?x dtou:requirement ?tag } => { ?x dtou:tag ?tag. ?tag a dtou:RequirementTag. }.
{ ?x dtou:tagging ?tag } => { ?x dtou:tag ?tag. ?tag a dtou:OfferTag. }.
{ ?x a dtou:DataPolicy; dtou:purpose ?purpose } => { ?x dtou:tagging ?purpose }.

{ ?x a dtou:InputSpec; dtou:purpose ?purpose } => { ?x dtou:expect ?purpose. ?purpose dtou:category dtou:PurposeCategory. }.
{ ?x a dtou:InputSpec; dtou:downstream [ dtou:purpose ?purpose ]. } => { ?x dtou:purpose ?purpose. }.

{ ?x a dtou:InputSpec; dtou:expect ?expect. } => { ?x dtou:capability ?expect. }.
{ ?x a dtou:InputSpec; dtou:provide ?provide. } => { ?x dtou:capability ?provide. }.

###
# Additional helper for reasoning (subclassing of items to be checked, e.g. tags)
###

{ ?c1 rdfs:subClassOf ?c2. ?c2 rdfs:subClassOf ?c3. } => { ?c1 rdfs:subClassOf ?c3. }.
{ ?x dtou:descriptor ?d. } => { ?d rdfs:subClassOf ?d. }.

### Helper to check condition is activated or not (and by the current app or downstream)
### {{{ Translate short-hand syntax to extended syntax
#### For FieldMatcher
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    ( dtou:app dtou:user ) list:iterate (?index ?p1).
    ( dtou:appField dtou:userField ) list:iterate (?index ?field).

    ?ac ?p1 ?v.
} => {
    ?ac dtou:matches [
        a dtou:FieldMatcher;
        dtou:field ?field;
        dtou:value ?v;
    ].
}.
#### For CategoryMatcher
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    ( dtou:requirement dtou:offer dtou:integrity dtou:purpose dtou:security ) list:iterate (?index ?p1).
    ( dtou:RequirementCategory dtou:OfferCategory dtou:IntegrityCategory dtou:PurposeCategory dtou:SecurityCategory dtou:userField ) list:iterate (?index ?category).

    ?ac ?p1 ?o.
} => {
    ?ac dtou:matches [
        a dtou:CategoryMatcher;
        dtou:source dtou:current, dtou:downstream;
        dtou:category ?category;
        dtou:descriptor ?o;
        dtou:categoryMatcher dtou:exactly;
        dtou:descriptorMatcher dtou:subClassFrom;
    ].
}.
### }}}
### {{{
# For current App
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    (
        {
            ?ac dtou:matches ?matcher.
            ?matcher a dtou:FieldMatcher.
        }

        {
            ?matcher dtou:field ?field;
                dtou:value ?value.

            _:t log:notIncludes {
                _:t log:notIncludes {
                    ?field log:equalTo dtou:appField.
                    _:t log:notIncludes {
                        _:t log:notIncludes {
                            ?app dtou:name ?value.
                        }.
                        _:t log:notIncludes {
                            ?input dtou:downstream [ dtou:app_name ?value ].
                        }
                    }
                }.
                _:t log:notIncludes {
                    ?field log:equalTo dtou:userField.
                    _:t log:notIncludes {
                        _:t log:notIncludes {
                            ?usage dtou:user ?value.
                        }.
                        _:t log:notIncludes {
                            ?input dtou:downstream [ dtou:user ?value ].
                        }
                    }
                }.
            }.
        }
    ) log:forAllIn _:t.

    (
        {
            ?ac dtou:matches ?matcher.
            ?matcher a dtou:CategoryMatcher.
        }
        {
            ?matcher dtou:category ?category;
                dtou:descriptor ?descriptor;
                dtou:categoryMatcher ?cm;
                dtou:descriptorMatcher ?dm.

            ?input dtou:capability [
                dtou:category ?category_p;
                dtou:descriptor ?descriptor_p;
            ].

            ?category log:equalTo ?category_p.

            _:t log:notIncludes {
                _:t log:notIncludes {
                    ?dm log:equalTo dtou:exactly.
                    ?descriptor log:equalTo ?descriptor_p.
                }.

                _:t log:notIncludes {
                    ?dm log:equalTo dtou:subClassFrom.
                    ?descriptor_p rdfs:subClassOf ?descriptor.
                }.

                _:t log:notIncludes {
                    ?dm log:equalTo dtou:superClassFrom.
                    ?descriptor rdfs:subClassOf ?descriptor_p.
                }.
            }.
        }
    ) log:forAllIn _:t.
} => {
    ?m a dri:MetCondition;
        dri:condition ?ac;
        dri:input ?input.
}.

###
# Included in appendix
###

# UsageContext
# \forall usage, data, app, input.
# related_data_app_input( ?usage, ?data, ?app, ?input ) <==>
#    UsageContext(?usage) /\ {usage.app.policy ?app} /\ AppPolicy(?app) /\ {?app.input_spec ?input} /\ Data(?data) /\ {?input.data ?data.uri}

{
    ?usage a dtou:UsageContext;
       dtou:app [ dtou:policy ?app ].

    ?app a dtou:AppPolicy;
        dtou:input_spec ?input.

    ?data a dtou:Data;
        dtou:uri ?uri.

    ?input dtou:data ?uri.
} => {
    ?m a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:app ?app;
        dri:data ?data;
        dri:input ?input.
}.

# input_policy_for_output ( ?input, ?policy, ?output_spec ) <==>
#    related_data_app_input( ?usage, ?data, ?app, ?input ) /\ {?app.output_spec ?output_spec} /\ {?output_spec.from ?inputPort} /\ {?input.port ?inputPort} /\ {?data.policy ?policy}

{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:app ?app;
        dri:data ?data;
        dri:input ?input.

    ?app dtou:output_spec ?output_spec.

    ?output_spec dtou:from ?inputPort.

    ?input dtou:port ?inputPort.

    ?data dtou:policy ?policy.

} => {
    ?m a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output_spec.
}.

######
# Reasoning rules
######

# # MatchResult
# # matches( ?matcher, ?arg1, ?arg2 ) <==> 
# #   ?matcher = Exact /\ ?arg1 = ?arg2
# #   \/ ?matcher = SubClassFrom /\ ?arg2 rdfs:subClassOf ?arg1
# #   \/ ?matcher = SuperClassFrom /\ ?arg1 rdfs:subClassOf ?arg2
# {
#     ?m a dri:MatchResult;
#         dri:matcher ?matcher;
#         dri:arg1 ?arg1;
#         dri:arg2 ?arg2.
# } <= {
#     _:t log:notIncludes {
#         _:t1 log:notIncludes {
#             ?matcher log:equalTo dtou:exactly.
#             ?arg1 log:equalTo ?arg2.
#         }.
#         _:t2 log:notIncludes {
#             ?matcher log:equalTo dtou:subClassFrom.
#             ?arg2 rdfs:subClassOf ?arg1.
#         }.
#         _:t3 log:notIncludes {
#             ?matcher log:equalTo dtou:superClassFrom.
#             ?arg1 rdfs:subClassOf ?arg2.
#         }.
#     }
# }.

# UnsatisfiedRequirement
# unsatisfied_requirement( ?port, ?category, ?descriptor ) <==> 
#   related_data_app_input( ?usage, ?data, ?app, ?input ) /\ {?data.policy.tag [a RequirementTag; category ?category; categoryMatcher ?cm; descriptorMatcher ?dm; descriptor ?descriptor]]} /\ {?input.port ?port} /\ ~ \exists ({?input.provide [category ?category'; descriptor ?descriptor']} /\ matches(?cm, ?category, ?category') /\ matches(?dm, ?descriptor, ?descriptor')).
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:tag [
            a dtou:RequirementTag;
            dtou:categoryMatcher ?cm;
            dtou:descriptorMatcher ?dm;
            dtou:category ?T;
            dtou:descriptor ?N
        ]
    ].

    ?input dtou:port ?port.

    _:t log:notIncludes {
        ?input dtou:provide [
            dtou:category ?T_p;
            dtou:descriptor ?N_p
        ].

        _:t log:notIncludes {
            _:t log:notIncludes {
                ?cm log:equalTo dtou:exactly.
                ?T log:equalTo ?T_p.
            }.

            _:t log:notIncludes {
                ?cm log:equalTo dtou:subClassFrom.
                ?T_p rdfs:subClassOf ?T.
            }.

            _:t log:notIncludes {
                ?cm log:equalTo dtou:superClassFrom.
                ?T rdfs:subClassOf ?T_p.
            }.
        }.

        _:t log:notIncludes {
            _:t log:notIncludes {
                ?dm log:equalTo dtou:exactly.
                ?N log:equalTo ?N_p.
            }.

            _:t log:notIncludes {
                ?dm log:equalTo dtou:subClassFrom.
                ?N_p rdfs:subClassOf ?N.
            }.

            _:t log:notIncludes {
                ?dm log:equalTo dtou:superClassFrom.
                ?N rdfs:subClassOf ?N_p.
            }.
        }.

        # ?matches1 a dri:MatchResult;
        #     dri:matcher ?cm;
        #     dri:arg1 ?T;
        #     dri:arg2 ?T_p.
        # ?matches2 a dri:MatchResult;
        #     dri:matcher ?dm;
        #     dri:arg1 ?N;
        #     dri:arg2 ?N_p.
    }.
} => {
    ?m a dtou:UnsatisfiedRequirement;
        dtou:port ?port;
        dtou:category ?T;
        dtou:descriptor ?N.
}.

# UnmatchedExpectation
# unmatched_expectation( ?port, ?category', ?descriptor' ) <==>
#   related_data_app_input( ?usage, ?data, ?app, ?input ) /\ {?input.expect [category ?category'; descriptor ?descriptor']} /\ {?input.port ?port} /\ ~ \exists ({?data.policy.tag [a OfferTag; category ?category; categoryMatcher ?cm; descriptorMatcher ?dm; descriptor ?descriptor]} /\ matches(?cm, ?category, ?category') /\ matches(?dm, ?descriptor, ?descriptor')).
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:expect [
        dtou:category ?T_p;
        dtou:descriptor ?N_p
    ].

    ?input dtou:port ?port.

    _:t log:notIncludes {
        ?data dtou:policy [
            dtou:tag [
                a dtou:OfferTag;
                dtou:categoryMatcher ?cm;
                dtou:descriptorMatcher ?dm;
                dtou:category ?T;
                dtou:descriptor ?N
            ]
        ].

        _:t log:notIncludes {
            _:t log:notIncludes {
                ?cm log:equalTo dtou:exactly.
                ?T log:equalTo ?T_p.
            }.

            _:t log:notIncludes {
                ?cm log:equalTo dtou:subClassFrom.
                ?T_p rdfs:subClassOf ?T.
            }.

            _:t log:notIncludes {
                ?cm log:equalTo dtou:superClassFrom.
                ?T rdfs:subClassOf ?T_p.
            }.
        }.

        _:t log:notIncludes {
            _:t log:notIncludes {
                ?dm log:equalTo dtou:exactly.
                ?N log:equalTo ?N_p.
            }.

            _:t log:notIncludes {
                ?dm log:equalTo dtou:subClassFrom.
                ?N_p rdfs:subClassOf ?N.
            }.

            _:t log:notIncludes {
                ?dm log:equalTo dtou:superClassFrom.
                ?N rdfs:subClassOf ?N_p.
            }.
        }.

        # ?matches1 a dri:MatchResult;
        #     dri:matcher ?cm;
        #     dri:arg1 ?T;
        #     dri:arg2 ?T_p.
        # ?matches2 a dri:MatchResult;
        #     dri:matcher ?dm;
        #     dri:arg1 ?N;
        #     dri:arg2 ?N_p.
    }.
} => {
    ?m a dtou:UnmatchedExpectation;
        dtou:port ?port;
        dtou:category ?T_p;
        dtou:descriptor ?N_p.
}.

# ProhibitedUse
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:port ?port.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:activation_condition ?ac
        ]
    ].

    ?mc a dri:MetCondition;
        dri:condition ?ac.
    ?ac dtou:mode ?mode.
    ?mode list:in ( dtou:use dtou:share ).

    # ?app dtou:name ?N.
    # ?input dtou:purpose ?P.

    # TODO: Add details of why prohibited use is triggered. Useful for complex conditions. Same for other rules for prohibition.
} => {
    ?m a dtou:ProhibitedUse;
        dtou:port ?port;
        dtou:condition ?ac.
}.
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:port ?port.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:activation_condition ?ac
        ]
    ].

    ?mc a dri:MetCondition;
        dri:condition ?ac.
    ?ac dtou:mode ?mode.
    ?mode log:equalTo dtou:aggregate.
    
    ?input dtou:port ?port.
    ?app dtou:output_spec ?output_spec.
    ?output_spec dtou:from ?port.
    _:t log:includes {
        ?output_spec dtou:port ?p2.
        ?p2 log:notEqualTo ?port.
    }.
} => {
    ?m a dtou:ProhibitedUse;
        dtou:port ?port;
        dtou:condition ?ac.
}.

{ ?x a dtou:UnsatisfiedRequirement.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:UnmatchedExpectation.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:ProhibitedUse.  } => { ?x a dtou:Conflict.  }.

# ActivatedObligation
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:obligation [
            dtou:obligation_class ?ob;
            dtou:argument ?args;
            dtou:activation_condition ?ac
        ]
    ].

    ?mc a dri:MetCondition;
        dri:condition ?ac.
} => {
    ?m a dtou:ActivatedObligation;
        dtou:obligation_class ?ob;
        dtou:argument ?args.
}.

# OutputAttribute
# For not Deleted nor Edited attributes
{
    ?x a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output.

    ?output dtou:port ?p.
    ?input dtou:port ?port.

    ?policy dtou:attribute ?attr.
    ?attr dtou:name ?n;
        dtou:class ?t;
        dtou:value ?v.
    
    _:t log:notIncludes {
        ?output dtou:refinement ?refi.
        ?refi
            dtou:filter ?filter.
        ?filter
            # dtou:input ?port;
            dtou:name ?n;
            dtou:class ?t;
            dtou:value ?v.
    }.
} => {
    ?m a dtou:OutputAttribute;
        dtou:name ?n;
        dtou:class ?t;
        dtou:value ?v.
    ?fl a dri:ForwardLink;
        dri:origin ?attr;
        dri:port ?p;
        dri:ref ?m.
}.
# For Edit
{
    ?x a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output.

    ?output dtou:port ?p.
    ?input dtou:port ?port.

    ?policy dtou:attribute ?attr.
    ?attr dtou:name ?n;
        dtou:class ?t1;
        dtou:value ?v1.
    
    ?output dtou:refinement ?refi.
    ?refi a dtou:Edit;
        dtou:filter ?filter;
        dtou:new_class ?t;
        dtou:new_value ?v.
    ?filter
        # dtou:input ?port;
        dtou:name ?n;
        dtou:class ?t1;
        dtou:value ?v1.
} => {
    ?m a dtou:OutputAttribute;
        dtou:name ?n;
        dtou:class ?t;
        dtou:value ?v.
    ?fl a dri:ForwardLink;
        dri:origin ?attr;
        dri:port ?p;
        dri:ref ?m.
}.

{
    ?x a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output.

    ?output dtou:port ?p.
    ?policy dtou:tag ?tagging.
    ?tagging dtou:category ?t;
        dtou:attribute_ref ?ar0.

    ?fl a dri:ForwardLink;
        dri:origin ?ar0;
        dri:port ?p;
        dri:ref ?ar.

    (
        { ?tagging dtou:validity_binding ?vb. }
        { ?fl2 a dri:ForwardLink; dri:origin ?vb; dri:port ?p. }
    ) log:forAllIn _:t.
} => {
    ?ot a dtou:Tag, dtou:OutputTag;
        dtou:category ?t;
        dtou:attribute_ref ?ar;
        dtou:port ?p.

    ?fl_ a dri:ForwardLink;
        dri:origin ?tagging;
        dri:port ?p;
        dri:ref ?ot.
}.

{
    ?ot a dtou:OutputTag;
        dtou:port ?p.

    ?fl0 a dri:ForwardLink;
        dri:origin ?tagging;
        dri:ref ?ot.

    # Note: cannot put to previous axiom (through log:collectAllIn), otherwise it will require existence of dtou:validity_binding
    ?tagging dtou:validity_binding ?vb.

    ?fl3 a dri:ForwardLink;
        dri:origin ?vb;
        dri:port ?p;
        dri:ref ?attr.
} => {
    ?ot dtou:validity_binding ?attr.
}.

{
    ?x a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output.

    ?output dtou:port ?p.
    ?policy dtou:prohibition ?pr.
    ?pr dtou:activation_condition ?ac.

    (
        { ?pr dtou:validity_binding ?vb. }
        { ?fl2 a dri:ForwardLink; dri:origin ?vb; dri:port ?p. }
    ) log:forAllIn _:t.
} => {
    ?mm a dtou:Prohibition, dtou:OutputProhibition;
        dtou:activation_condition ?ac;
        dtou:port ?p.

    ?fl a dri:ForwardLink;
        dri:origin ?pr;
        dri:port ?p;
        dri:ref ?mm.
}.

{
    ?m a dtou:Prohibition;
        dtou:port ?p.

    ?fl0 a dri:ForwardLink;
        dri:origin ?pr;
        dri:port ?p;
        dri:ref ?m.

    ?pr dtou:validity_binding ?vb.

    ?fl a dri:ForwardLink;
        dri:origin ?vb;
        dri:port ?p;
        dri:ref ?attr.
} => {
    ?m dtou:validity_binding ?attr.
}.

{
    ?x a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output.

    ?output dtou:port ?p.
    ?policy dtou:obligation ?ob.
    ?ob dtou:obligation_class ?oc;
        dtou:argument ?arg;
        dtou:activation_condition ?ac.

    (
        { ?ob dtou:validity_binding ?vb. }
        { ?fl2 a dri:ForwardLink; dri:origin ?vb; dri:port ?p. }
    ) log:forAllIn _:t.

    (
        ?v1
        {
            ?v list:in ?arg.
            ?fl a dri:ForwardLink;
                dri:origin ?v;
                dri:port ?p;
                dri:ref ?v1.
        }
        ?args
    ) log:collectAllIn _:t.
} => {
    ?M a dtou:Obligation, dtou:OutputObligation;
        dtou:obligation_class ?oc;
        dtou:argument ?args;
        dtou:activation_condition ?ac;
        dtou:port ?p.

    ?fl_ a dri:ForwardLink;
        dri:origin ?ob;
        dri:port ?p;
        dri:ref ?M.
}.

{
    ?m a dtou:OutputObligation;
        dtou:port ?p.

    ?fl0 a dri:ForwardLink;
        dri:origin ?ob;
        dri:port ?p;
        dri:ref ?m.

    ?ob dtou:validity_binding ?vb.

    ?fl a dri:ForwardLink;
        dri:origin ?vb;
        dri:port ?p;
        dri:ref ?attr.
} => {
    ?m dtou:validity_binding ?attr.
}.

# {
#     ?x a dtou:Obligation;
#         dtou:from ?ob.

#     ?ob dtou:argument ?arg.

# } => {}.


# {
#     ?x a dtou:InputPolicyForOutput;
#         dtou:input ?input;
#         dtou:policy ?policy;
