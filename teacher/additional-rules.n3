@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix dtou: <urn:dtou:core#>.
@prefix dri: <urn:dtou:internal#>.
@prefix vt: <urn:dtou:vocabulary-teacher#> .
@prefix : <http://example.org/ns#>.

###
# To simplify platform's app policy writing.
# Automatically convert `dtou:purpose ?purpose` to the expected long form.
###

{
    ?x a dtou:InputSpec;
        dtou:purpose ?purpose.

    _:t log:notIncludes {
        ?purpose a dtou:Expectation;
    }.
} => {
    ?x dtou:purpose ?P1.

    ?P1 a dtou:Expectation;
        dtou:category dtou:PurposeCategory;
        dtou:descriptor ?purpose.

}.

{
    ?x a dtou:InputSpec;
        dtou:downstream [
            dtou:purpose ?purpose
        ].

    _:t log:notIncludes {
        ?purpose a dtou:Expectation;
    }.
} => {
    ?x dtou:purpose ?P1.

    ?P1 a dtou:Expectation;
        dtou:category dtou:PurposeCategory;
        dtou:descriptor ?purpose.

}.

###
# To handle different data types
###

# Google
{
    ?x a dtou:InputSpec;
        dtou:data vt:CustomerData.

    ( vt:Communication vt:TeachingActivity vt:UploadedMaterials ) list:iterate ( ?i ?dt ).
} => {
    ?x dtou:data ?dt.
}.

# Google
{
    ?x a dtou:InputSpec;
        dtou:data vt:CustomerPersonalData.

    ( vt:PersonalInfo ) list:iterate ( ?i ?dt ).
} => {
    ?x dtou:data ?dt.
}.

# Microsoft
{
    ?x a dtou:InputSpec;
        dtou:data vt:Data.

    ( vt:Communication vt:PersonalInfo vt:ServiceData vt:TeachingActivity vt:UploadedMaterials ) list:iterate ( ?i ?dt ).
} => {
    ?x dtou:data ?dt.
}.

# Microsoft
{
    ?x a dtou:InputSpec;
        dtou:data vt:PersonalData.

    ( vt:Communication vt:PersonalInfo vt:UploadedMaterials ) list:iterate ( ?i ?dt ).
} => {
    ?x dtou:data ?dt.
}.
