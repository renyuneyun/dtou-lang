@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix dri: <urn:dtou:internal#>.
@prefix voc: <urn:dtou:vocabulary#>.
@prefix ex: <http://example.org/ns#>.
@prefix q: <http://example.org/query/ns#>.

######
# Query
######

# (_:s _:p _:o) log:onQuerySurface {
# 	_:s a dri:RelatedDataAppInput.
# 	_:s _:p _:o.
# }.

# (_:s _:p _:o) log:onQuerySurface {
# 	_:s a dri:InputPolicyForOutput.
# 	_:s _:p _:o.
# }.

# (_:s _:p _:o) log:onQuerySurface {
# 	_:s a dri:DeletedAttribute.
# 	_:s _:p _:o.
# }.

q:query_condition
    q:property dtou:app, dtou:purpose.

q:query_attribute
    q:property rdf:type, dtou:name, dtou:class, dtou:value.

{
    ?type list:in (dtou:UnsatisfiedRequirement dtou:UnmatchedExpectation dtou:ProhibitedUse).

    ?s a ?type;
        ?p ?o.
} => {
    ?s ?p ?o.
}.

{
    ?pu a dtou:ProhibitedUse;
        dtou:condition ?c.
    ?c ?p ?o.

    q:query_condition q:property ?p.
} => {
    ?c ?p ?o.
}.

{
    ?s a dtou:ActivatedObligation;
        ?p ?o.
} => {
    ?s ?p ?o.
}.

{
    ?s a dtou:OutputAttribute;
        ?p ?o.

    q:query_attribute q:property ?p.
} => {
    ?s ?p ?o.
}.

{
    ?type list:in (dtou:OutputTag dtou:OutputProhibition dtou:OutputObligation).

    ?s a ?type;
        ?p ?o.
} => {
    ?s ?p ?o.
}.

{
    ?type list:in (dtou:OutputProhibition dtou:OutputObligation).

    ?s a ?type;
        dtou:activation_condition ?ac.
    ?ac ?p ?o.

    q:query_condition q:property ?p.
} => {
    ?ac ?p ?o.
}.
