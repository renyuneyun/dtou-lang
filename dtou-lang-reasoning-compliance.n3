@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix dtou: <http://example.org/ns#>.
@prefix dri: <http://example.org/ns2#>.

######
# Helper implications for the language
######

###
# General helper
###
{ ?x dtou:attribute_ref [ dtou:class ?N ].  } => { ?x dtou:descriptor ?N.  }.

{ ?x a dtou:Security.  } => { ?x dtou:category dtou:SecurityType.  }.
{ ?x a dtou:Integrity.  } => { ?x dtou:category dtou:IntegrityType.  }.
{ ?x a dtou:Purpose.  } => { ?x dtou:category dtou:PurposeType.  }.
{ ?x a dtou:PurposeExpectation.  } => { ?x dtou:category dtou:PurposeType.  }.
{ ?x a dtou:IntegrityExpectation.  } => { ?x dtou:category dtou:IntegrityType.  }.
{ ?x a dtou:SecurityProvide.  } => { ?x dtou:category dtou:SecurityType.  }.

{ ?x dtou:requirement ?tagging } => { ?x dtou:tag ?tagging }.
{ ?x dtou:tagging ?tagging } => { ?x dtou:tag ?tagging }.

### Helper to check condition is activated or not (and by the current app or downstream)
### {{{
# For current App
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:user ?U.
            ?usage dtou:user ?U.
        }.

        ?ac dtou:user ?U0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:app ?N.
            ?app dtou:name ?N.
        }.

        ?ac dtou:app ?N0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:purpose ?P.
            ?input dtou:purpose [ dtou:descriptor ?P ].
        }.

        ?ac dtou:purpose ?P0.
    }.
} => {
    ?ac a dri:MetCondition;
        dri:met_by dri:Current.
}.
# For downstream
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    ?input dtou:downstream ?ds.
    
    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:app ?N.
            ?ds dtou:app_name ?N.
        }.

        ?ac dtou:app ?N0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:purpose ?P.
            ?ds dtou:purpose [ dtou:descriptor ?P ].
        }.

        ?ac dtou:purpose ?P0.
    }.
} => {
    ?ac a dri:MetCondition;
        dri:met_by dri:Downstream.
}.
### }}}

###
# Included in appendix
###

# UsageContext
# \forall usage, data, app, input.
# related_data_app_input( ?usage, ?data, ?app, ?input ) <==>
#    UsageContext(?usage) /\ {usage.app.policy ?app} /\ AppPolicy(?app) /\ {?app.input_spec ?input} /\ Data(?data) /\ {?input.data ?data.uri}

{
    ?usage a dtou:UsageContext;
       dtou:app [ dtou:policy ?app ].

    ?app a dtou:AppPolicy;
        dtou:input_spec ?input.

    ?data a dtou:Data;
        dtou:uri ?uri.

    ?input dtou:data ?uri.
} => {
    ?m a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:app ?app;
        dri:data ?data;
        dri:input ?input.
}.

# input_policy_for_output ( ?input, ?policy, ?output_spec ) <==>
#    related_data_app_input( ?usage, ?data, ?app, ?input ) /\ {?app.output_spec ?output_spec} /\ {?output_spec.from ?inputPort} /\ {?input.port ?inputPort} /\ {?data.policy ?policy}

{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:app ?app;
        dri:data ?data;
        dri:input ?input.

    ?app dtou:output_spec ?output_spec.

    ?output_spec dtou:from ?inputPort.

    ?input dtou:port ?inputPort.

    ?data dtou:policy ?policy.

} => {
    ?m a dri:InputPolicyForOutput;
        dri:input ?input;
        dri:policy ?policy;
        dri:output_spec ?output_spec.
}.

######
# Reasoning rules
######

# UnsatisfiedRequirement
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:requirement [
            dtou:category ?T;
            dtou:descriptor ?N
        ]
    ].

    _:t log:notIncludes {
            ?input dtou:provide ?provide.
            ?provide dtou:category ?T;
                dtou:descriptor ?N.
    }.
} => {
    ?m a dtou:UnsatisfiedRequirement;
        dtou:category ?T;
        dtou:descriptor ?N.
}.

# UnmatchedExpectation
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:expect [
        dtou:category ?T;
        dtou:descriptor ?N
        ].

    _:t log:notIncludes {
        ?data dtou:policy [
            dtou:tagging [
                dtou:category ?T;
                dtou:descriptor ?N
            ]
        ].
    }
} => {
    ?m a dtou:UnmatchedExpectation;
        dtou:category ?T;
        dtou:descriptor ?N.
}.

# ProhibitedUse
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:mode dtou:Use;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition.

    # ?app dtou:name ?N.
    # ?input dtou:purpose ?P.

    # TODO: Add details of why prohibited use is triggered. Useful for complex conditions
} => {
    ?m a dtou:ProhibitedUse;
        dtou:condition ?ac.
}.

{ ?x a dtou:UnsatisfiedRequirement.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:UnmatchedExpectation.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:ProhibitedUse.  } => { ?x a dtou:Conflict.  }.

# ActivatedObligation
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:obligation [
            dtou:obligation_class ?ob;
            dtou:argument ?args;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition.
} => {
    ?m a dtou:ActivatedObligation;
        dtou:obligation_class ?ob;
        dtou:argument ?args.
}.

