@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix dtou: <urn:dtou:core#>.
@prefix dri: <urn:dtou:internal#>.
@prefix : <http://example.org/ns#>.

######
# Helper implications for the language
######

###
# General helper
###
{ ?x dtou:attribute_ref [ dtou:class ?N ].  } => { ?x dtou:descriptor ?N.  }.

{ ?x a dtou:SecurityTag.  } => { ?x dtou:category dtou:SecurityType.  }.
{ ?x a dtou:IntegrityTag.  } => { ?x dtou:category dtou:IntegrityType.  }.
{ ?x a dtou:PurposeTag.  } => { ?x dtou:category dtou:PurposeType.  }.
{ ?x a dtou:PurposeExpectation.  } => { ?x dtou:category dtou:PurposeType.  }.
{ ?x a dtou:IntegrityExpectation.  } => { ?x dtou:category dtou:IntegrityType.  }.
{ ?x a dtou:SecurityProvide.  } => { ?x dtou:category dtou:SecurityType.  }.

{ ?x dtou:requirement ?tagging } => { ?x dtou:tag ?tagging }.
{ ?x dtou:tagging ?tagging } => { ?x dtou:tag ?tagging }.
{ ?x a dtou:DataPolicy; dtou:purpose ?purpose } => { ?x dtou:tagging ?purpose }.

{ ?x a dtou:InputSpec; dtou:purpose ?purpose } => { ?x dtou:expect ?purpose }.
{ ?x a dtou:InputSpec; dtou:downstream [ dtou:purpose ?purpose ]. } => { ?x dtou:purpose ?purpose. }.

###
# Additional helper for reasoning (subclassing of items to be checked, e.g. tags)
###

{ ?x dtou:descriptor ?d. } => { ?d rdfs:subClassOf ?d. }.
{ ?c1 rdfs:subClassOf ?c2. ?c2 rdfs:subClassOf ?c3. } => { ?c1 rdfs:subClassOf ?c3. }.


### Helper to check condition is activated or not (and by the current app or downstream)
### {{{
# For current App
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:user ?U.
            ?usage dtou:user ?U.
        }.

        ?ac dtou:user ?U0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:app ?N.
            ?app dtou:name ?N.
        }.

        ?ac dtou:app ?N0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:purpose ?P.
            ?input dtou:purpose [ dtou:descriptor [ rdfs:subClassOf ?P ] ].
        }.

        ?ac dtou:purpose ?P0.
    }.
} => {
    ?ac a dri:MetCondition;
        dri:met_by dri:Current.
}.
# For downstream
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [ ?p [ dtou:activation_condition ?ac ] ].

    ?input dtou:downstream ?ds.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:app ?N.
            ?ds dtou:app_name ?N.
        }.

        ?ac dtou:app ?N0.
    }.

    _:t log:notIncludes {
        _:t log:notIncludes {
            ?ac dtou:purpose ?P.
            ?ds dtou:purpose [ dtou:descriptor [ rdfs:subClassOf ?P ] ].
        }.

        ?ac dtou:purpose ?P0.
    }.
} => {
    ?ac a dri:MetCondition;
        dri:met_by dri:Downstream.
}.
### }}}

###
# Included in appendix
###

# UsageContext
# \forall usage, data, app, input.
# related_data_app_input( ?usage, ?data, ?app, ?input ) <==>
#    UsageContext(?usage) /\ {usage.app.policy ?app} /\ AppPolicy(?app) /\ {?app.input_spec ?input} /\ Data(?data) /\ {?input.data ?data.uri}

{
    ?usage a dtou:UsageContext;
       dtou:app [ dtou:policy ?app ].

    ?app a dtou:AppPolicy;
        dtou:input_spec ?input.

    ?data a dtou:Data;
        dtou:uri ?uri.

    ?input dtou:data ?uri.
} => {
    ?m a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:app ?app;
        dri:data ?data;
        dri:input ?input.
}.

######
# Reasoning rules
######

# UnsatisfiedRequirement
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:requirement [
            dtou:category ?T;
            dtou:descriptor ?N
        ]
    ].

    ?input dtou:port ?port.

    _:t log:notIncludes {
            ?input dtou:provide ?provide.
            ?N rdfs:subClassOf ?Ns.
            ?provide dtou:category ?T;
                dtou:descriptor ?Ns.
    }.
} => {
    ?m a dtou:UnsatisfiedRequirement;
        dtou:port ?port;
        dtou:category ?T;
        dtou:descriptor ?N.
}.

# UnmatchedExpectation
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:expect [
        dtou:category ?T;
        dtou:descriptor ?N
        ].

    ?input dtou:port ?port.

    _:t log:notIncludes {
        ?N rdfs:subClassOf ?Ns.
        ?data dtou:policy [
            dtou:tagging [
                dtou:category ?T;
                dtou:descriptor ?Ns
            ]
        ].
    }.
} => {
    ?m a dtou:UnmatchedExpectation;
        dtou:port ?port;
        dtou:category ?T;
        dtou:descriptor ?N.
}.

# ProhibitedUse
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:port ?port.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:mode dtou:Use;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition.

    # ?app dtou:name ?N.
    # ?input dtou:purpose ?P.

    # TODO: Add details of why prohibited use is triggered. Useful for complex conditions. Same for other rules for prohibition.
} => {
    ?m a dtou:ProhibitedUse;
        dtou:port ?port;
        dtou:mode dtou:Use;
        dtou:condition ?ac.
}.
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:port ?port.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:mode dtou:Share;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition;
        dri:met_by dri:Downstream.
} => {
    ?m a dtou:ProhibitedUse;
        dtou:port ?port;
        dtou:mode dtou:Share;
        dtou:condition ?ac.
}.
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?input dtou:port ?port.
    
    ?data dtou:policy [
        dtou:prohibition [
            dtou:mode dtou:Aggregate;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition.
    
    ?input dtou:port ?port.
    ?app dtou:output_spec ?output_spec.
    ?output_spec dtou:from ?port.
    _:t log:includes {
        ?output_spec dtou:port ?p2.
        ?p2 log:notEqualTo ?port.
    }.
} => {
    ?m a dtou:ProhibitedUse;
        dtou:port ?port;
        dtou:mode dtou:Aggregate;
        dtou:condition ?ac.
}.

{ ?x a dtou:UnsatisfiedRequirement.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:UnmatchedExpectation.  } => { ?x a dtou:Conflict.  }.
{ ?x a dtou:ProhibitedUse.  } => { ?x a dtou:Conflict.  }.

# ActivatedObligation
{
    ?x a dri:RelatedDataAppInput;
        dri:usage ?usage;
        dri:data ?data;
        dri:app ?app;
        dri:input ?input.

    ?data dtou:policy [
        dtou:obligation [
            dtou:obligation_class ?ob;
            dtou:argument ?args;
            dtou:activation_condition ?ac
        ]
    ].

    ?ac a dri:MetCondition.
} => {
    ?m a dtou:ActivatedObligation;
        dtou:obligation_class ?ob;
        dtou:argument ?args.
}.
