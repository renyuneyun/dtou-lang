@prefix : <urn:dtou:example-vocabulary#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <urn:dtou:example-vocabulary#> .

<urn:dtou:example-vocabulary> rdf:type owl:Ontology ;
                               owl:imports <urn:dtou:core> .

#################################################################
#    Classes
#################################################################

###  urn:dtou:example-vocabulary#acknowledge
:acknowledge rdf:type owl:Class ;
             rdfs:subClassOf <urn:dtou:core#ObligationClass> .


###  urn:dtou:example-vocabulary#booking
:booking rdf:type owl:Class ;
         rdfs:subClassOf <urn:dtou:core#Purpose> .


###  urn:dtou:example-vocabulary#complete
:complete rdf:type owl:Class ;
          rdfs:subClassOf <urn:dtou:core#Integrity> .


###  urn:dtou:example-vocabulary#personal
:personal rdf:type owl:Class ;
          rdfs:subClassOf <urn:dtou:core#Security> ;
          owl:disjointWith :secure .


###  urn:dtou:example-vocabulary#recording
:recording rdf:type owl:Class ;
           rdfs:subClassOf <urn:dtou:core#Purpose> .


###  urn:dtou:example-vocabulary#research
:research rdf:type owl:Class ;
          rdfs:subClassOf <urn:dtou:core#Purpose> .


###  urn:dtou:example-vocabulary#secure
:secure rdf:type owl:Class ;
        rdfs:subClassOf <urn:dtou:core#Security> .


#################################################################
#    Individuals
#################################################################

###  urn:dtou:example-vocabulary#nil
:nil rdf:type owl:NamedIndividual .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :booking
                :recording
                :research
              )
] .


