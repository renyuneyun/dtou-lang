@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:vocabulary#>.
@prefix ex: <http://example.org/ns#>.

:let :ignoredSecondary dtou:descriptor, dtou:activation_condition, dtou:condition.

{
	?a a dtou:Conflict;
		?p ?o.
} => {
	?a ?p ?o.
}.

{
	?a a dtou:Conflict;
		?p ?o0.
	_:t log:notIncludes { :let :ignoredSecondary ?p }.
	?o0 ?p1 ?o1.
} => {
	?a a dtou:Conflict;
		?p ?o0.
	?o0 ?p1 ?o1.
}.

{
	( dtou:mode dtou:app dtou:purpose dtou:user ) list:iterate ( ?i ?p ).
	?a a dtou:ProhibitedUse;
		dtou:condition ?o0.
	?o0 ?p ?o1.
} => {
	?a a dtou:ProhibitedUse;
		dtou:condition ?o0.
	?o0 ?p ?o1.
}.
