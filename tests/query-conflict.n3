@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix : <http://example.org/ns#>.

{
	?a a :Conflict;
		?p ?o.
} => {
	?a ?p ?o.
}.

{
	( :port ) list:iterate ( ?i ?p ).
	?a a :Conflict;
		?p ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a :Conflict;
		?p ?o0.
	?o0 ?p1 ?o1.
}.
