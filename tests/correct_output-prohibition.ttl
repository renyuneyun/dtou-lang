@prefix ex: <http://example.org/ns#> .
@prefix dtou: <urn:dtou:core#> .
@prefix voc: <urn:dtou:example-vocabulary#> .

ex:inputPort1 a dtou:Port ;
    dtou:name "inputPort1" .

ex:inputPort2 a dtou:Port ;
    dtou:name "inputPort2" .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-verify-identity> ;
    dtou:port ex:inputPort1 .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-booking> ;
    dtou:port ex:inputPort1 .

[] a dtou:Conflict,
        dtou:ProhibitedUse ;
    dtou:port ex:inputPort1 ;
    dtou:condition [ dtou:app <urn:dtou:appoint-booking> ;
            dtou:purpose <urn:dtou:purpose-verify-identity> ] ;
    dtou:mode dtou:Use .

[] a dtou:Conflict,
        dtou:ProhibitedUse ;
    dtou:port ex:inputPort1 ;
    dtou:condition [ dtou:purpose dtou:Purpose ] ;
    dtou:mode dtou:Share .

[] a dtou:Conflict,
        dtou:ProhibitedUse ;
    dtou:port ex:inputPort2 ;
    dtou:condition [ ] ;
    dtou:mode dtou:Aggregate .
