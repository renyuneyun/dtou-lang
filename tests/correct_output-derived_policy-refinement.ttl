@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:example-vocabulary#>.
@prefix ex: <http://example.org/ns#>.

_:sk_4 a dtou:OutputAttribute;
  #dtou:port ex:outputPort1;
  dtou:name voc:ada-p;
  dtou:class voc:not-a-person;
  dtou:value voc:adaa.
_:sk_27 a dtou:OutputAttribute;
  #dtou:port voc:outputPort1;
  dtou:name voc:sec-attr;
  dtou:class voc:secure;
  dtou:value voc:nil.
_:sk_31 a dtou:OutputAttribute;
  #dtou:port ex:outputPort1;
  dtou:name voc:per-attr;
  dtou:class voc:personal;
  dtou:value voc:nil.
_:sk_35 a dtou:OutputAttribute;
  #dtou:port ex:outputPort1;
  dtou:name voc:compl-attr;
  dtou:class voc:complete;
  dtou:value voc:nil.
_:sk_43 a dtou:OutputTag;
  dtou:port ex:outputPort1;
  #dtou:descriptor voc:personal;
  dtou:attribute_ref _:sk_31;
  dtou:validity_binding _:sk_4;
  dtou:category dtou:SecurityType.
[] a dtou:OutputTag;
	dtou:attribute_ref [ a dtou:OutputAttribute;
	        dtou:name voc:compl-attr;
	        dtou:class voc:complete;
	        dtou:value voc:nil ];
    dtou:category dtou:IntegrityType;
    #dtou:descriptor dtou:complete;
    dtou:port ex:outputPort1.
_:sk_61 a dtou:OutputObligation;
  dtou:port ex:outputPort1;
  dtou:obligation_class voc:acknowledge;
  dtou:argument (_:sk_4);
  dtou:activation_condition [ dtou:purpose voc:research ].
_:sk_49 a dtou:OutputProhibition;
  dtou:port ex:outputPort1;
  dtou:activation_condition _:ac1;
  dtou:mode dtou:Use.
_:sk_52 a dtou:OutputProhibition;
  dtou:port ex:outputPort1;
  dtou:activation_condition _:ac2;
  dtou:mode dtou:Use.
[] a dtou:OutputProhibition;
    dtou:mode dtou:Use;
    dtou:activation_condition [
            dtou:app <https://not.exist/app>;
            dtou:purpose <urn:dtou:purpose-booking>;
	  ];
    dtou:port ex:outputPort1 .
_:ac1 dtou:app <urn:dtou:appoint-booking>;
  dtou:purpose <urn:dtou:purpose-verify-identity>.
_:ac2 dtou:app <https://gh.app/clinic>;
  dtou:purpose <urn:dtou:purpose-booking>.
