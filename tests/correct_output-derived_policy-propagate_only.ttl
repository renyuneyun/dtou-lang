@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:example-vocabulary#>.
@prefix ex: <http://example.org/ns#>.

[] a dtou:OutputTag;
    dtou:attribute_ref [ a dtou:OutputAttribute ;
            dtou:class voc:secure ;
            dtou:name voc:sec-attr ;
            dtou:value voc:nil ] ;
    dtou:category dtou:SecurityType ;
    #dtou:descriptor dtou:secure ;
    dtou:port ex:outputPort1 ;
    #dtou:type dtou:TagType,
    #    dtou:TaggingType ;
    dtou:validity_binding _:n91d38d10d0fe4719ae77ebb75783a7f9b1,
        [ a dtou:OutputAttribute ;
            dtou:class voc:testClass ;
            dtou:name voc:test ;
            dtou:value voc:testValue ] .

[] a dtou:OutputTag;
    dtou:attribute_ref [ a dtou:OutputAttribute ;
            dtou:class voc:personal ;
            dtou:name voc:per-attr ;
            dtou:value voc:nil ] ;
    dtou:category dtou:SecurityType ;
    #dtou:descriptor dtou:personal ;
    dtou:port ex:outputPort1 ;
    #dtou:type dtou:TagType,
    #    dtou:TaggingType ;
    dtou:validity_binding _:n91d38d10d0fe4719ae77ebb75783a7f9b1 .

[] a dtou:OutputTag;
	dtou:attribute_ref [ a dtou:OutputAttribute;
	        dtou:name voc:compl-attr;
	        dtou:class voc:complete;
	        dtou:value voc:nil ];
    dtou:category dtou:IntegrityType;
    #dtou:descriptor dtou:complete;
    dtou:port ex:outputPort1.

[] a dtou:OutputProhibition;
    dtou:activation_condition [ dtou:app <urn:dtou:appoint-booking> ;
            dtou:purpose <urn:dtou:purpose-verify-identity> ] ;
    dtou:mode dtou:Use ;
    dtou:port ex:outputPort1 .

[] a dtou:OutputProhibition;
    dtou:activation_condition [ dtou:app <https://gh.app/clinic> ;
            dtou:purpose <urn:dtou:purpose-booking> ] ;
    dtou:mode dtou:Use ;
    dtou:port ex:outputPort1 .

[] a dtou:OutputProhibition;
    dtou:mode dtou:Use;
    dtou:activation_condition [
            dtou:app <https://not.exist/app>;
            dtou:purpose <urn:dtou:purpose-booking>;
	];
    dtou:port ex:outputPort1 .

[] a dtou:OutputObligation ;
    dtou:activation_condition [ dtou:purpose voc:research ] ;
    dtou:argument ( _:n91d38d10d0fe4719ae77ebb75783a7f9b1 ) ;
    dtou:obligation_class voc:acknowledge ;
    dtou:port ex:outputPort1 .

[] a dtou:OutputAttribute ;
    dtou:class voc:complete ;
    dtou:name voc:compl-attr ;
    dtou:value voc:nil .

_:n91d38d10d0fe4719ae77ebb75783a7f9b1 a dtou:OutputAttribute ;
    dtou:class voc:person ;
    dtou:name voc:ada-p ;
    dtou:value voc:ada .

