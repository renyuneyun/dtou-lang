@prefix dtou: <http://example.org/ns#> .
@prefix voc: <http://example.org/ns#> .
@prefix ex: <http://example.org/ns#> .

[] a dtou:Conflict,
        dtou:UnsatisfiedRequirement ;
    dtou:port ex:inputPort1;
    dtou:category dtou:SecurityType ;
    dtou:descriptor voc:secure .

[] a dtou:Conflict,
        dtou:UnsatisfiedRequirement ;
    dtou:port ex:inputPort1;
    dtou:category dtou:SecurityType ;
    dtou:descriptor voc:personal .

ex:inputPort1 a dtou:Port;
    dtou:name "inputPort1".

