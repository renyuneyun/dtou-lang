@prefix : <http://example.org/ns#> .
@prefix dtou: <urn:dtou:core#> .
@prefix voc: <urn:dtou:vocabulary#> .

:inputPort1 a dtou:Port ;
    dtou:name "inputPort1" .

[] a dtou:Conflict,
        dtou:UnsatisfiedRequirement ;
    dtou:category dtou:SecurityCategory ;
    dtou:descriptor voc:personal ;
    dtou:port :inputPort1 .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-verify-identity> ;
    dtou:port :inputPort1 .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-verify-age> ;
    dtou:port :inputPort1 .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-booking> ;
    dtou:port :inputPort1 .

[] a dtou:Conflict,
        dtou:UnmatchedExpectation ;
    dtou:category dtou:PurposeCategory ;
    dtou:descriptor <urn:dtou:purpose-recording> ;
    dtou:port :inputPort1 .

[] a dtou:Conflict,
        dtou:ProhibitedUse ;
    dtou:port :inputPort1 ;
    dtou:condition [
        dtou:mode dtou:use;
        dtou:app <urn:dtou:appoint-booking> ;
        dtou:purpose <urn:dtou:purpose-verify-identity> ] .

[] a dtou:Conflict,
        dtou:ProhibitedUse ;
    dtou:port :inputPort1 ;
    dtou:condition [
        dtou:mode dtou:use;
        dtou:app <https://gh.app/clinic> ;
        dtou:purpose <urn:dtou:purpose-booking> ] .

