@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix : <http://example.org/ns#>.

{
	#( rdf:type :name :class :value :port ) list:iterate ( ?i ?p ).
	( :name :class :value :port ) list:iterate ( ?i ?p ).
	?a a :OutputAttribute;
		?p ?o.
} => {
	?a a :OutputAttribute;
		?p ?o.
}.

{
	#( rdf:type :category :attribute_ref :validity_binding :port ) list:iterate ( ?i ?p ).
	( :category :attribute_ref :validity_binding :port ) list:iterate ( ?i ?p ).
	?a a :OutputTag;
		?p ?o.
} => {
	?a a :OutputTag;
		?p ?o.
}.

{
	?a a :OutputTag;
		:port ?port.
	?port ?p ?o.
} => {
	?a a :OutputTag;
		:port ?port.
	?port ?p ?o.
}.

{
	( :attribute_ref :validity_binding ) list:iterate ( ?i ?p ).
	( rdf:type :name :class :value ) list:iterate ( ?i ?p1 ).
	?a a :OutputTag;
		?p ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a :OutputTag;
		?p ?o0.
	?o0 ?p1 ?o1.
}.