@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:example-vocabulary#>.
@prefix : <http://example.org/ns#>.

:let :ignoreProperties owl:topObjectProperty.

{
	#( rdf:type dtou:category dtou:attribute_ref dtou:validity_binding dtou:port ) list:iterate ( ?i ?p ).
	( dtou:category dtou:attribute_ref dtou:validity_binding dtou:port ) list:iterate ( ?i ?p ).
	?a a dtou:OutputTag;
		?p ?o.
} => {
	?a a dtou:OutputTag;
		?p ?o.
}.

{
	?a a dtou:OutputTag;
		dtou:port ?port.
	?port ?p ?o.

	(
		{ :let :ignoreProperties ?ip }
		{ ?p log:notEqualTo ?ip }
	) log:forAllIn _:t.
} => {
	?a a dtou:OutputTag;
		dtou:port ?port.
	?port ?p ?o.
}.

{
	( dtou:attribute_ref dtou:validity_binding ) list:iterate ( ?i ?p ).
	( rdf:type dtou:name dtou:class dtou:value ) list:iterate ( ?i2 ?p1 ).
	?a a dtou:OutputTag;
		?p ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a dtou:OutputTag;
		?p ?o0.
	?o0 ?p1 ?o1.
}.
