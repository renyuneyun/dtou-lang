@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:vocabulary#>.
@prefix ex: <http://example.org/ns#>.
@prefix : <urn:example:ns#>.

:let :ignored dtou:descriptor;
	:ignoredSecondary dtou:descriptor, dtou:activation_condition.

{
	?a a dtou:OutputTag;
		?p ?o.

	_:t log:notIncludes { :let :ignored ?p }.
} => {
	?a a dtou:OutputTag;
		?p ?o.
}.

{
	?a a dtou:OutputTag;
		?p ?o0.
	_:t log:notIncludes { :let :ignoredSecondary ?p }.
	?o0 ?p1 ?o1.
} => {
	?a a dtou:OutputTag;
		?p ?o0.
	?o0 ?p1 ?o1.
}.
