@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:vocabulary#>.
@prefix ex: <http://example.org/ns#>.

{
	#( rdf:type dtou:activation_condition dtou:argument dtou:obligation_class dtou:port ) list:iterate ( ?i ?p ).
	( dtou:activation_condition dtou:argument dtou:obligation_class dtou:validity_binding dtou:port ) list:iterate ( ?i ?p ).
	?a a dtou:OutputObligation;
		?p ?o.
} => {
	?a a dtou:OutputObligation;
		?p ?o.
}.

{
	( dtou:activation_condition dtou:port ) list:iterate ( ?i ?p ).
	?a a dtou:OutputObligation;
		?p ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a dtou:OutputObligation;
		?p ?o0.
	?o0 ?p1 ?o1.
}.

{
	( rdf:type dtou:name dtou:class dtou:value ) list:iterate ( ?i ?p1 ).
	?a a dtou:OutputObligation;
		dtou:validity_binding ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a dtou:OutputObligation;
		dtou:validity_binding ?o0.
	?o0 ?p1 ?o1.
}.

{
	?a a dtou:OutputObligation;
		dtou:argument ?arg.
    ?arg list:iterate ( ?i2 ?o0 ).
	( rdf:type dtou:name dtou:class dtou:value ) list:iterate ( ?i ?p1 ).
	?o0 a dtou:OutputAttribute;
        ?p1 ?o1.
} => {
	?o0 ?p1 ?o1.
}.
