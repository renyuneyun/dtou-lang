@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix : <http://example.org/ns#>.

{
	#( rdf:type :activation_condition :argument :obligation_class :port ) list:iterate ( ?i ?p ).
	( :activation_condition :argument :obligation_class :validity_binding :port ) list:iterate ( ?i ?p ).
	?a a :OutputObligation;
		?p ?o.
} => {
	?a a :OutputObligation;
		?p ?o.
}.

{
	( :activation_condition :port ) list:iterate ( ?i ?p ).
	?a a :OutputObligation;
		?p ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a :OutputObligation;
		?p ?o0.
	?o0 ?p1 ?o1.
}.

{
	( rdf:type :name :class :value ) list:iterate ( ?i ?p1 ).
	?a a :OutputObligation;
		:validity_binding ?o0.
	?o0 ?p1 ?o1.
} => {
	?a a :OutputObligation;
		:validity_binding ?o0.
	?o0 ?p1 ?o1.
}.

{
	?a a :OutputObligation;
		:argument ?arg.
    ?arg list:iterate ( ?i2 ?o0 ).
	( rdf:type :name :class :value ) list:iterate ( ?i ?p1 ).
	?o0 a :OutputAttribute;
        ?p1 ?o1.
} => {
	?o0 ?p1 ?o1.
}.