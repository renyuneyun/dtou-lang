@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix dtou: <urn:dtou:core#>.
@prefix voc: <urn:dtou:vocabulary#>.
@prefix ex: <http://example.org/ns#>.

######
# Data Policy
######

ex:attr1 a dtou:Attribute;
	dtou:name voc:ada-p;
	dtou:class voc:person;
	dtou:value voc:ada.

ex:attr2 a dtou:Attribute;
	dtou:name voc:test;
	dtou:class voc:testClass;
	dtou:value voc:testValue.

ex:sec-attr1 a dtou:Attribute;
	dtou:name voc:sec-attr;
	dtou:class voc:secure;
	dtou:value voc:nil.

ex:per-attr1 a dtou:Attribute;
	dtou:name voc:per-attr;
	dtou:class voc:personal;
	dtou:value voc:nil.

ex:compl-attr1 a dtou:Attribute;
	dtou:name voc:compl-attr;
	dtou:class voc:complete;
	dtou:value voc:nil.

ex:sec-tag a dtou:RequirementTag;
	dtou:category dtou:SecurityCategory;
	dtou:categoryMatcher dtou:exactly;
	dtou:descriptorMatcher dtou:subClassFrom;
	dtou:attribute_ref ex:sec-attr1;
	dtou:validity_binding ex:attr1, ex:attr2.

ex:per-tag1 a dtou:RequirementTag;
	dtou:category dtou:SecurityCategory;
	dtou:categoryMatcher dtou:exactly;
	dtou:descriptorMatcher dtou:subClassFrom;
	dtou:attribute_ref ex:per-attr1;
	dtou:validity_binding ex:attr1.

ex:compl-tag1 a dtou:OfferTag;
	dtou:category dtou:IntegrityCategory;
	dtou:categoryMatcher dtou:exactly;
	dtou:descriptorMatcher dtou:superClassFrom;
	dtou:attribute_ref ex:compl-attr1.

# Should not be activated for voc:research
# (Manual) Should be activated for voc:verify-identity
ex:ob1 a dtou:Obligation;
	dtou:obligation_class voc:acknowledge;
	dtou:argument (ex:attr1);
	# dtou:validity_binding ex:attr1;
	dtou:onCondition [
		dtou:purpose voc:research
		# dtou:purpose  <urn:dtou:purpose-verify-identity>
	].

# Should be activated by App
### short-hand syntax
ex:pr1 a dtou:Prohibition;
	dtou:onCondition [
		a dtou:ActivationCondition;
		dtou:mode dtou:use;
		dtou:app <urn:dtou:appoint-booking>;
		dtou:matches [
			a dtou:CapabilityMatcher;
			dtou:category dtou:PurposeCategory;
			dtou:categoryMatcher dtou:exactly;
			dtou:descriptorMatcher dtou:subClassFrom;
			dtou:descriptor <urn:dtou:purpose-verify-identity>;
		];
	].

# Should be activated by downstream
ex:pr2 a dtou:Prohibition;
	dtou:onCondition [
		a dtou:ActivationCondition;
		dtou:mode dtou:use;
		dtou:matches [
			a dtou:ContextMatcher;
			dtou:field dtou:appField;
			dtou:value <https://gh.app/clinic>;
		]
		dtou:matches [
			a dtou:CapabilityMatcher;
			dtou:category dtou:PurposeCategory;
			dtou:categoryMatcher dtou:exactly;
			dtou:descriptorMatcher dtou:subClassFrom;
			dtou:descriptor <urn:dtou:purpose-booking>;
		];
	].

# Should not be activated
ex:pr3 a dtou:Prohibition;
	dtou:onCondition [
		a dtou:ActivationCondition;
		dtou:mode dtou:use;
		dtou:app <https://gh.app/bad_guy>;
		dtou:matches [
			a dtou:CapabilityMatcher;
			dtou:category dtou:PurposeCategory;
			dtou:categoryMatcher dtou:exactly;
			dtou:descriptorMatcher dtou:subClassFrom;
			dtou:descriptor <urn:dtou:purpose-booking>>;
		];
	].

ex:data1 a dtou:Data;
	dtou:uri <https://ada.site/id>;
	dtou:policy ex:policy1.

ex:policy1 a dtou:DataPolicy;
	dtou:attribute ex:attr1, ex:sec-attr1, ex:per-attr1, ex:compl-attr1, ex:attr2;
	dtou:tag ex:sec-tag1, ex:per-tag1;
	# dtou:tagging ex:compl-tag1;
	dtou:tag ex:pr1, ex:pr2, ex:pr3;
	dtou:obligation ex:ob1.

ex:data2 a dtou:Data;
	dtou:uri <https://ada.site/email>;
	dtou:policy ex:policy2.

ex:policy2 a dtou:DataPolicy;
	dtou:attribute ex:any-purpose-attr1;
	dtou:tag ex:any-purpose.

ex:any-purpose a dtou:OfferTag;
	dtou:category dtou:PurposeCategory;
	dtou:categoryMatcher dtou:exactly;
	dtou:descriptorMatcher dtou:superClassFrom;
	dtou:attribute_ref ex:any-purpose-attr1.

ex:any-purpose-attr1 a dtou:Attribute;
	dtou:name _:a;
	dtou:class dtou:Purpose;
	dtou:value voc:nil.
